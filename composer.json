{
    "name": "firma/kpir-server",
    "description": "Backend synchronizacji KPiR dla aplikacji Firma krok po kroku (PHP + MySQL).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": { "Firma\\": "src/" }
    },
    "config": {
        "optimize-autoloader": true
    }
}
